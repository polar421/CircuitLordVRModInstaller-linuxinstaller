<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CircuitLord.VRModInstaller.Localization"
             x:Class="CircuitLord.VRModInstaller.SettingsView"
             Focusable="True"
             KeyDown="Settings_KeyDown">

  <Border Name="SettingsOverlay" Background="#D914171C" IsVisible="False">
    <Grid>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
              CornerRadius="{DynamicResource CornerCard}" Width="540" MaxHeight="680"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,18,22,12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr Key=settings}" Classes="h1" />
              <TextBlock Text="{loc:Tr Key=settingsSubtitle}" Classes="small" />
            </StackPanel>
            <Button Grid.Column="1" Name="SettingsCloseButton" Content="{loc:Tr Key=close}" Classes="ghost"
                    Click="CloseSettings_Click" />
          </Grid>
          <Border Grid.Row="0" Height="1" Background="{StaticResource Stroke}" VerticalAlignment="Bottom" />

          <ScrollViewer Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Margin="22,14,22,18">
            <StackPanel Width="494" Spacing="12">

              <!-- Appearance -->
              <TextBlock Text="{loc:Tr Key=appearance}" Classes="h2" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Tr Key=roundedCorners}" FontSize="12" />
                  <TextBlock Text="{loc:Tr Key=roundedCornersDescription}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Name="RoundedCornersToggle" VerticalAlignment="Center"
                              OnContent="" OffContent="" IsCheckedChanged="RoundedCorners_Changed" />
              </Grid>
              <TextBlock Text="{loc:Tr Key=appearanceUnsupportedNote}" Classes="small" TextWrapping="Wrap" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- Language -->
              <TextBlock Text="{loc:Tr Key=language}" Classes="h2" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Tr Key=interfaceLanguage}" FontSize="12" />
                  <TextBlock Text="{loc:Tr Key=languageRestart}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" Name="LanguageCombo" MinWidth="150" VerticalAlignment="Center"
                          SelectionChanged="Language_SelectionChanged">
                  <ComboBoxItem Content="English" Tag="en" />
                  <ComboBoxItem Content="Deutsch" Tag="de" />
                </ComboBox>
              </Grid>

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- Updates -->
              <TextBlock Text="{loc:Tr Key=updates}" Classes="h2" />
              <TextBlock Text="{loc:Tr Key=installerApplicationUpdates}" FontSize="13" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=currentInstalledVersion}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsCurrentAppVersion" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=latestAvailableVersion}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsLatestAppVersion" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Tr Key=checkForUpdates}" FontSize="12" />
                  <TextBlock Text="{loc:Tr Key=checkForUpdatesDescription}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Name="AppUpdatesToggle" VerticalAlignment="Center"
                              OnContent="" OffContent="" IsCheckedChanged="AppUpdates_Changed" />
              </Grid>
              <TextBlock Name="SettingsUpdateStatus" Text="{loc:Tr Key=updatesNotChecked}" Classes="small"
                         TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="SettingsCheckAppButton" Content="{loc:Tr Key=checkNow}" Classes="ghost" FontSize="11.5" Padding="8,4"
                        Click="CheckUpdates_Click" />
                <Button Name="SettingsOpenReleaseButton" Content="{loc:Tr Key=openRelease}" Classes="ghost"
                        FontSize="11.5" Padding="8,4" IsEnabled="False" Click="OpenRelease_Click" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Key=updateChecksInfo}" Classes="small" TextWrapping="Wrap" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <TextBlock Text="{loc:Tr Key=helperUpdates}" FontSize="13" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=currentHelperCommit}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsBackendCurrent" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=latestHelperCommit}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsBackendLatest" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=helperWorkingTree}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsBackendWorkingTree" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=lastSuccessfulUpdate}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsBackendLastUpdate" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Tr Key=updateHelperAutomatic}" FontSize="12" />
                  <TextBlock Text="{loc:Tr Key=updateHelperAutomaticDescription}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Name="BackendUpdatesToggle" VerticalAlignment="Center"
                              OnContent="" OffContent="" IsCheckedChanged="BackendUpdates_Changed" />
              </Grid>
              <ProgressBar Name="SettingsBackendProgress" IsIndeterminate="True" IsVisible="False" Height="3" />
              <TextBlock Name="SettingsBackendStatus" Text="{loc:Tr Key=backendUpdateNotChecked}" Classes="small"
                         TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="SettingsBackendCheckButton" Content="{loc:Tr Key=checkNow}" Classes="ghost"
                        FontSize="11.5" Padding="8,4" Click="CheckBackend_Click" />
                <Button Name="SettingsBackendUpdateButton" Content="{loc:Tr Key=updateHelperNow}" Classes="ghost"
                        FontSize="11.5" Padding="8,4" Click="UpdateBackendSettings_Click" />
              </StackPanel>
              <TextBlock Name="SettingsBackendRecovery" Classes="small" TextWrapping="Wrap" />
              <TextBlock Text="{loc:Tr Key=helperUpdateNote}" Classes="small" TextWrapping="Wrap" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- VR integration -->
              <TextBlock Text="{loc:Tr Key=vrIntegration}" Classes="h2" />
              <TextBlock Text="{loc:Tr Key=vrIntegrationDescription}" Classes="small" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=activeOpenXrRuntime}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsOpenXr" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamVrAvailability}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamVr" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=wivrnAvailability}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsWiVrn" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=monadoAvailability}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsMonado" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=openVrBridge}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsOpenVrBridge" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=tf2vrLauncher}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsLauncher" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=desktopEntry}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsDesktopEntry" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Name="SettingsRepairWivrnButton" Content="{loc:Tr Key=repairWivrnEntry}" Classes="ghost" FontSize="11.5" Padding="8,4"
                        Click="RepairWivrn_Click" />
                <Button Grid.Column="1" Name="SettingsReinstallGameButton" Content="{loc:Tr Key=reinstallGameEntry}" Classes="ghost" FontSize="11.5"
                        Padding="8,4" Click="ReinstallGameEntry_Click" />
                <Button Grid.Row="1" Name="SettingsViewRuntimeButton" Content="{loc:Tr Key=viewRuntimeInfo}" Classes="ghost" FontSize="11.5"
                        Padding="8,4" Click="ViewRuntime_Click" />
                <Button Grid.Row="1" Grid.Column="1" Name="SettingsLauncherLogButton" Content="{loc:Tr Key=openLauncherLog}" Classes="ghost"
                        FontSize="11.5" Padding="8,4" Click="OpenLauncherLog_Click" />
              </Grid>
              <TextBlock Text="{loc:Tr Key=runtimeInfoNote}" Classes="small" TextWrapping="Wrap" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- Steam integration -->
              <TextBlock Text="{loc:Tr Key=steamIntegration}" Classes="h2" />
              <TextBlock Text="{loc:Tr Key=steamIntegrationDescription}" Classes="small" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamDetectedStatus}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamStatus" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamInstallationType}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamType" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamInstallationPath}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamInstallation" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamSelectedAccount}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamAccount" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamShortcutStatus}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamShortcut" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=steamShortcutExecutable}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamExecutable" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=lastSteamOperation}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsSteamLastOperation" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Tr Key=askBeforeSteamRestart}" FontSize="12" />
                  <TextBlock Text="{loc:Tr Key=askBeforeSteamRestartDescription}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Name="ConfirmSteamRestartToggle" VerticalAlignment="Center"
                              OnContent="" OffContent="" IsCheckedChanged="ConfirmSteamRestart_Changed" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Name="SettingsSteamAddButton" Content="{loc:Tr Key=addToSteam}" Classes="ghost"
                        FontSize="11.5" Padding="8,4" Click="AddSteamSettings_Click" />
                <Button Grid.Column="1" Name="SettingsSteamRepairButton" Content="{loc:Tr Key=repairShortcut}"
                        Classes="ghost" FontSize="11.5" Padding="8,4" Click="RepairSteamSettings_Click" />
                <Button Grid.Column="2" Name="SettingsSteamRemoveButton" Content="{loc:Tr Key=removeShortcut}"
                        Classes="ghost" FontSize="11.5" Padding="8,4" Click="RemoveSteamSettings_Click" />
              </Grid>
              <TextBlock Text="{loc:Tr Key=steamRestartNote}" Classes="small" TextWrapping="Wrap" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- Diagnostics -->
              <TextBlock Text="{loc:Tr Key=diagnostics}" Classes="h2" />
              <TextBlock Text="{loc:Tr Key=diagnosticsDescription}" Classes="small" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=lastPreflight}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsLastPreflight" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <TextBox Name="DiagnosticsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="monospace" FontSize="10.5" MinHeight="120" MaxHeight="170"
                       Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}"
                       BorderThickness="1" CornerRadius="{DynamicResource CornerInner}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Name="SettingsRunChecksButton" Content="{loc:Tr Key=runChecks}" Classes="ghost" FontSize="11.5" Padding="8,4"
                        Click="RunChecks_Click" />
                <Button Grid.Column="1" Name="SettingsViewLogsButton" Content="{loc:Tr Key=viewLogs}" Classes="ghost" FontSize="11.5"
                        Padding="8,4" Click="ViewLogs_Click" />
                <Button Grid.Row="1" Name="SettingsOpenLogsButton" Content="{loc:Tr Key=openLogDirectory}" Classes="ghost" FontSize="11.5"
                        Padding="8,4" Click="OpenLogDirectory_Click" />
                <Button Grid.Row="1" Grid.Column="1" Name="CopyReportButton" Content="{loc:Tr Key=copyDiagnosticReport}"
                        Classes="ghost" FontSize="11.5" Padding="8,4" Click="CopyDiagnostics_Click" />
              </Grid>
              <TextBlock Text="{loc:Tr Key=diagnosticsPrivacy}" Classes="small" TextWrapping="Wrap" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- About -->
              <TextBlock Text="{loc:Tr Key=about}" Classes="h2" />
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=aboutName}" Classes="small" />
                <TextBlock Grid.Column="1" Text="CircuitLord's VR Mod Installer" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=aboutVersion}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsAboutVersion" Classes="small"
                           Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=aboutPlatform}" Classes="small" />
                <TextBlock Grid.Column="1" Name="SettingsAboutPlatform" Classes="small"
                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Content="{loc:Tr Key=originalProject}" Classes="ghost" FontSize="11.5" Padding="8,4"
                        Tag="https://github.com/CircuitLord/CircuitLordVRModInstaller" Click="OpenLink_Click" />
                <Button Grid.Column="1" Content="{loc:Tr Key=linuxBackendRepo}" Classes="ghost" FontSize="11.5"
                        Padding="8,4" Tag="https://github.com/Monkellie/tf2vr-linux" Click="OpenLink_Click" />
                <Button Grid.Row="1" Content="{loc:Tr Key=officialManifest}" Classes="ghost" FontSize="11.5"
                        Padding="8,4"
                        Tag="https://raw.githubusercontent.com/CircuitLord/CircuitLordVRModInstaller/main/manifest-v3.json"
                        Click="OpenLink_Click" />
                <Button Grid.Row="1" Grid.Column="1" Content="{loc:Tr Key=license}" Classes="ghost" FontSize="11.5"
                        Padding="8,4"
                        Tag="https://github.com/polar421/CircuitLordVRModInstaller-linuxinstaller/blob/main/LICENSE"
                        Click="OpenLink_Click" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=licenseName}" Classes="small" />
                <TextBlock Grid.Column="1" Text="MIT License" Classes="small" Foreground="{StaticResource Text}" />
              </Grid>
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="{loc:Tr Key=thirdPartyAttribution}" Classes="small" />
                <TextBlock Grid.Column="1" Text="{loc:Tr Key=thirdPartyText}" Classes="small" TextWrapping="Wrap" />
              </Grid>
              <Button Content="{loc:Tr Key=thirdPartyNotices}" Classes="ghost" FontSize="11.5" Padding="8,4"
                      HorizontalAlignment="Left"
                      Tag="https://github.com/polar421/CircuitLordVRModInstaller-linuxinstaller/blob/main/THIRD-PARTY-NOTICES.md"
                      Click="OpenLink_Click" />

              <Border Height="1" Background="{StaticResource Stroke}" />

              <!-- Restore defaults -->
              <TextBlock Text="{loc:Tr Key=restoreDefaults}" Classes="h2" />
              <TextBlock Text="{loc:Tr Key=restoreDefaultsDescription}" Classes="small" TextWrapping="Wrap" />
              <Button Name="SettingsRestoreButton" Content="{loc:Tr Key=restoreDefaultsButton}" Classes="danger" FontSize="11.5" Padding="8,4"
                      HorizontalAlignment="Left" Click="RestoreDefaults_Click" />

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- runtime details -->
      <Border Name="RuntimeOverlay" Background="#E614171C" IsVisible="False">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                CornerRadius="{DynamicResource CornerCard}" Padding="22,18" Width="520" MaxHeight="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr Key=runtimeInfoTitle}" FontSize="16" FontWeight="SemiBold" />
            <TextBox Name="RuntimeInfoTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="monospace" FontSize="11" MinHeight="170" MaxHeight="300"
                     Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}"
                     BorderThickness="1" CornerRadius="{DynamicResource CornerInner}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button Content="{loc:Tr Key=close}" Classes="ghost" HorizontalAlignment="Right" Click="CloseRuntime_Click" />
          </StackPanel>
        </Border>
      </Border>

      <!-- logs -->
      <Border Name="LogsOverlay" Background="#E614171C" IsVisible="False">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                CornerRadius="{DynamicResource CornerCard}" Padding="22,18" Width="520" MaxHeight="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr Key=logsTitle}" FontSize="16" FontWeight="SemiBold" />
            <TextBox Name="LogsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="monospace" FontSize="11" MinHeight="220" MaxHeight="320"
                     Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}"
                     BorderThickness="1" CornerRadius="{DynamicResource CornerInner}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button Content="{loc:Tr Key=close}" Classes="ghost" HorizontalAlignment="Right" Click="CloseLogs_Click" />
          </StackPanel>
        </Border>
      </Border>

      <!-- confirmation -->
      <Border Name="ConfirmOverlay" Background="#E614171C" IsVisible="False">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                CornerRadius="{DynamicResource CornerCard}" Padding="22,18" Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel Spacing="10">
            <TextBlock Name="ConfirmTitle" FontFamily="avares://CircuitLordVRModInstaller/Assets/Fonts#Liberation Serif"
                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Name="ConfirmText" FontFamily="avares://CircuitLordVRModInstaller/Assets/Fonts#Liberation Serif"
                       FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
              <Button Name="ConfirmCancelButton" Content="{loc:Tr Key=cancel}" Classes="ghost"
                      FontFamily="avares://CircuitLordVRModInstaller/Assets/Fonts#Liberation Serif"
                      Click="ConfirmCancel_Click" />
              <Button Name="ConfirmOkButton" Content="{loc:Tr Key=close}" Classes="primary"
                      FontFamily="avares://CircuitLordVRModInstaller/Assets/Fonts#Liberation Serif"
                      Click="ConfirmOk_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>
