<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:CircuitLord.VRModInstaller.Localization"
        xmlns:local="using:CircuitLord.VRModInstaller"
        x:Class="CircuitLord.VRModInstaller.MainWindow"
        Title="{loc:Tr Key=windowTitle}"
        Width="800" Height="740"
        MinWidth="560" MinHeight="520"
        CanResize="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{DynamicResource Bg}">

  <Border Name="WindowFrame" Background="{DynamicResource Bg}"
          CornerRadius="{DynamicResource CornerWindow}" ClipToBounds="True">
  <LayoutTransformControl Name="RootScale">
  <Grid RowDefinitions="46,*">

    <!-- title bar: original icon, name and a Linux version marker -->
    <Grid Grid.Row="0" Name="TitleBar" Background="{DynamicResource Bg}" PointerPressed="TitleBar_PointerPressed"
          ColumnDefinitions="*,Auto,Auto">
      <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="16,0,10,0">
        <Image Source="avares://CircuitLordVRModInstaller/Assets/app-256.png" Width="20" Height="20"
               VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{loc:Tr Key=windowTitle}"
                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{loc:Tr Key=windowTitle}" />
        <Border Grid.Column="2" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,1,0,0">
          <TextBlock Name="VersionText" Text="{Binding AppVersion}" FontSize="10.5" Foreground="{DynamicResource TextDim}" />
        </Border>
      </Grid>
      <Border Grid.Column="1" Name="TitlebarBusyIndicator" IsVisible="False"
              Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource AccentBorder}"
              BorderThickness="1" CornerRadius="{DynamicResource CornerPill}"
              Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center"
              ToolTip.Tip="{loc:Tr Key=operationInProgress}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Accent}"
                  VerticalAlignment="Center" />
          <TextBlock Name="TitlebarBusyText" FontSize="10.5" MaxWidth="190"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Accent}" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
        <local:NotificationCenterView Name="NotificationCenter" VerticalAlignment="Center" />
        <Button Name="SettingsButton" Classes="titlebar" Click="OpenSettings_Click" ToolTip.Tip="{loc:Tr Key=settings}"
                AutomationProperties.Name="{loc:Tr Key=settings}">
          <Path Data="M 1,3 L 11,3 M 1,9 L 11,9 M 4,0.5 L 4,5.5 M 8,6.5 L 8,11.5"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                Width="12" Height="12" Stretch="None" />
        </Button>
        <Button Classes="titlebar" Click="Minimize_Click" ToolTip.Tip="{loc:Tr Key=minimize}"
                AutomationProperties.Name="{loc:Tr Key=minimize}">
          <Path Data="M 0,0 L 10,0" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                Width="10" Height="1" Stretch="None" />
        </Button>
        <Button Classes="titlebar close" Click="Close_Click" ToolTip.Tip="{loc:Tr Key=close}"
                AutomationProperties.Name="{loc:Tr Key=close}">
          <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                Width="10" Height="10" Stretch="None" />
        </Button>
      </StackPanel>
      <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Stroke}" IsHitTestVisible="False" />
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">
      <Grid Grid.Row="0" Margin="18,6,18,0">
        <ScrollViewer Name="GameScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- game selection -->
          <StackPanel Name="GameSelect" Classes="main-content">
            <TextBlock Text="{loc:Tr Key=chooseGame}" Classes="h1" Margin="2,0,0,10" />

            <!-- Big Walk stays unavailable: disabled, with the Linux backend state spelled out. -->
            <Button Name="BigWalkCard" Classes="gamecard" Height="96" HorizontalAlignment="Stretch"
                    IsEnabled="False" AutomationProperties.Name="Big Walk VR">
              <Grid ColumnDefinitions="200,*,Auto">
                <Border CornerRadius="{DynamicResource CornerCardLeft}" ClipToBounds="True">
                  <Border.Background>
                    <ImageBrush Source="avares://CircuitLordVRModInstaller/Assets/big-walk.jpg" Stretch="UniformToFill" Opacity="0.45" />
                  </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0" Spacing="2">
                  <TextBlock Text="Big Walk VR" Classes="card-title" />
                  <TextBlock Name="BigWalkStatus" Text="{loc:Tr Key=notAvailableLinux}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerInner}" Padding="8,3" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Tr Key=noBackend}" FontSize="10.5" Foreground="{DynamicResource TextDim}" />
                </Border>
              </Grid>
            </Button>

            <!-- Titanfall 2 is selectable; NEW mirrors the original selection card. -->
            <Button Name="TitanfallCard" Classes="gamecard" Height="96" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Titanfall 2 VR" Click="SelectTitanfall_Click">
              <Grid ColumnDefinitions="200,*,Auto">
                <Border Name="TitanfallThumbnail" CornerRadius="{DynamicResource CornerCardLeft}" ClipToBounds="True">
                  <Border.Background>
                    <ImageBrush Source="avares://CircuitLordVRModInstaller/Assets/titanfall-2.jpg" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,8,0,0" IsHitTestVisible="False">
                  <TextBlock Text="{loc:Tr Key=new}" Classes="badge-text" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0" Spacing="2">
                  <TextBlock Text="Titanfall 2 VR" Classes="card-title" />
                  <TextBlock Name="TitanfallStatus" Text="{loc:Tr Key=checkingInstallation}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
                <Path Grid.Column="2" Classes="chevron" Data="M 0,0 L 5,6 L 0,12"
                      Width="6" Height="12" Stretch="None" VerticalAlignment="Center" Margin="0,0,16,0"
                      IsHitTestVisible="False" />
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Single transition-owned Titanfall surface: nav, tabs and content
             enter, leave, and become inert together. -->
        <Grid Name="InstallerPage" IsVisible="False" RowDefinitions="Auto,Auto,*">
          <!-- page navigation stays outside the tab content so it never scrolls away -->
          <Grid Name="InstallerNav" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <Button Name="BackToGamesButton" Classes="ghost" Width="32" Height="32" Padding="0" Click="Back_Click"
                    ToolTip.Tip="{loc:Tr Key=backToGames}" AutomationProperties.Name="{loc:Tr Key=backToGames}">
              <Path Data="M 6,0 L 0,6 L 6,12" Width="7" Height="12" Stretch="None"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
            </Button>
            <TextBlock Grid.Column="1" Text="{loc:Tr Key=modInstallation}" Classes="small"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>

          <local:TitanfallTabBar Name="InstallerTabs" Grid.Row="1" Margin="0,0,0,8"
                                 SelectionChanged="TitanfallTabs_SelectionChanged" />

          <Grid Name="TitanfallTabContent" Grid.Row="2">
          <ScrollViewer Name="InstallerScroll" IsVisible="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- overview -->
          <StackPanel Name="InstallerView" Spacing="0">

            <!-- large artwork hero with the useful installation state in one place -->
            <Border Name="HeroArtwork" Height="250" CornerRadius="{DynamicResource CornerCard}" ClipToBounds="True" Margin="0,0,0,10">
              <Grid>
                <Border>
                  <Border.Background>
                    <ImageBrush Source="avares://CircuitLordVRModInstaller/Assets/titanfall-2.jpg" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="{DynamicResource HeroFadeTop}" />
                      <GradientStop Offset="0.36" Color="{DynamicResource HeroFadeMid}" />
                      <GradientStop Offset="1" Color="{DynamicResource HeroFadeBottom}" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0" Color="{DynamicResource HeroShadeTop}" />
                      <GradientStop Offset="0.62" Color="{DynamicResource HeroShadeMid}" />
                      <GradientStop Offset="1" Color="{DynamicResource HeroShadeClear}" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Grid Name="HeroContent" Margin="20,16,20,18" RowDefinitions="Auto,*,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="TITANFALL 2 · VR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource HeroTextMuted}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" Name="HeroStatusChip" Background="{DynamicResource Overlay}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerPill}" Padding="10,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Name="HeroStatusText" Text="{loc:Tr Key=overviewNotInstalled}" FontSize="10.5" Foreground="{DynamicResource HeroTextSoft}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                    <StackPanel Spacing="2" Margin="0,0,14,0">
                      <TextBlock Text="Titanfall 2 VR" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource HeroText}" />
                      <TextBlock Text="{loc:Tr Key=overviewTagline}" FontSize="12" Foreground="{DynamicResource HeroTextSoft}" />
                      <WrapPanel Margin="0,10,0,0">
                        <Border Classes="hero-chip" Margin="0,0,7,0">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{loc:Tr Key=installedVersion}" Classes="hero-chip-label" />
                            <TextBlock Name="HeroInstalledVersion" Classes="hero-chip-value" />
                          </StackPanel>
                        </Border>
                        <Border Classes="hero-chip" Margin="0,0,7,0">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{loc:Tr Key=selectedChannel}" Classes="hero-chip-label" />
                            <TextBlock Name="HeroSelectedChannel" Classes="hero-chip-value" />
                          </StackPanel>
                        </Border>
                        <Border Classes="hero-chip">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{loc:Tr Key=update}" Classes="hero-chip-label" />
                            <TextBlock Name="HeroUpdateText" Classes="hero-chip-value" />
                          </StackPanel>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Name="HeroLaunchButton" Classes="primary hero-action"
                            Click="Launch_Click" IsVisible="False" VerticalAlignment="Bottom">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="M 0,0 L 0,12 L 10,6 Z" Fill="{Binding $parent[Button].Foreground}"
                              Width="10" Height="12" Stretch="None" />
                        <TextBlock Text="{loc:Tr Key=launchVr}" Foreground="{Binding $parent[Button].Foreground}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <!-- live release summary -->
            <Grid Name="ReleaseSummary" ColumnDefinitions="*,*,*" Margin="0,0,0,0">
              <Border Name="InstalledVersionCard" Grid.Column="0" Classes="card version-card" Margin="0,0,8,10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Tr Key=installedVersion}" Classes="small" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBlock Name="InstalledVersionValue" Text="{loc:Tr Key=notInstalled}" FontSize="17" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Classes="copy" Content="⧉" Tag="InstalledVersionValue"
                            Click="CopyField_Click" ToolTip.Tip="{loc:Tr Key=copyVersion}"
                            AutomationProperties.Name="{loc:Tr Key=copyVersion}" />
                  </Grid>
                  <TextBlock Name="ChannelValue" Text="{loc:Tr Key=channelUnknown}" Classes="small" TextTrimming="CharacterEllipsis" />
                  <!-- Reserve the row so the three version cards keep equal heights. -->
                  <Grid Height="18" Margin="0,2,0,0">
                    <Border Name="InstalledVersionBadge" Classes="status-pill" IsVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Name="InstalledVersionBadgeText" Classes="status-pill-text" />
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Name="LatestStableCard" Grid.Column="1" Classes="card version-card" Margin="0,0,8,10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Tr Key=latestStable}" Classes="small" />
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Name="LatestStableValue" Text="{loc:Tr Key=notAvailable}" FontSize="17" FontWeight="SemiBold" />
                    <Button Classes="copy" Content="⧉" Tag="LatestStableValue"
                            Click="CopyField_Click" ToolTip.Tip="{loc:Tr Key=copyVersion}"
                            AutomationProperties.Name="{loc:Tr Key=copyVersion}" />
                    <Border Name="LatestStableBadge" Classes="status-pill" IsVisible="False" VerticalAlignment="Center">
                      <TextBlock Name="LatestStableBadgeText" Classes="status-pill-text" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{loc:Tr Key=channelStable}" Classes="small" />
                </StackPanel>
              </Border>
              <Border Name="LatestBetaCard" Grid.Column="2" Classes="card version-card" Margin="0,0,0,10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Tr Key=latestBeta}" Classes="small" />
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Name="LatestBetaValue" Text="{loc:Tr Key=notAvailable}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                    <Button Classes="copy" Content="⧉" Tag="LatestBetaValue"
                            Click="CopyField_Click" ToolTip.Tip="{loc:Tr Key=copyVersion}"
                            AutomationProperties.Name="{loc:Tr Key=copyVersion}" />
                    <Border Name="LatestBetaBadge" Classes="status-pill" IsVisible="False" VerticalAlignment="Center">
                      <TextBlock Name="LatestBetaBadgeText" Classes="status-pill-text" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{loc:Tr Key=channelBeta}" Classes="small" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- release picker and main action -->
            <Border Name="ReleaseSection" Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Key=release}" Classes="h2" />
                    <local:HelpTip Name="ReleaseChannelHelp"
                                   Title="{loc:Tr Key=helpChannelsTitle}"
                                   Body="{loc:Tr Key=helpChannelsBody}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Name="CatalogueText" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center"
                             TextAlignment="Right" MaxWidth="330" />
                </Grid>

                <Button Name="VersionPickerButton" Classes="selector" HorizontalAlignment="Stretch"
                        Click="VersionPicker_Click" AutomationProperties.Name="{loc:Tr Key=chooseRelease}">
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Spacing="1">
                      <TextBlock Name="VersionPickerTitle" FontSize="12.5" FontWeight="SemiBold" />
                      <TextBlock Name="VersionPickerMeta" Classes="small" />
                    </StackPanel>
                    <Path Grid.Column="1" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextDim}"
                          StrokeThickness="1.5" Width="10" Height="6" Stretch="None" Margin="10,0,0,0" />
                  </Grid>
                </Button>

                <Button Name="BrowseReleasesButton" Content="{loc:Tr Key=browseReleases}"
                        Classes="ghost" FontSize="11.5" Padding="8,4" HorizontalAlignment="Left"
                        Click="BrowseReleases_Click" />

                <Popup Name="VersionPopup" PlacementTarget="{Binding #VersionPickerButton}" Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="True" VerticalOffset="6">
                  <LayoutTransformControl Name="VersionPopupScale">
                  <Border Name="VersionPopupPanel" Classes="popup" Width="520" MaxHeight="340"
                          KeyDown="VersionPopup_KeyDown">
                    <Grid RowDefinitions="Auto,*">
                      <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,7">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{loc:Tr Key=chooseRelease}" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{loc:Tr Key=releasesFromCatalogue}" Classes="small" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Classes="ghost" Width="26" Height="26" Padding="0"
                                Click="CloseVersionPicker_Click" ToolTip.Tip="{loc:Tr Key=close}" />
                      </Grid>
                      <ScrollViewer Name="VersionScroll" Grid.Row="1" MaxHeight="286" VerticalScrollBarVisibility="Auto"
                                    AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled"
                                    HorizontalContentAlignment="Stretch"
                                    ScrollViewer.IsScrollChainingEnabled="False">
                        <ItemsControl Name="VersionGroupsList" Margin="6,0,6,7"
                                      HorizontalAlignment="Stretch">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                <StackPanel Margin="10,4,10,4" Spacing="1">
                                  <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold"
                                             Foreground="{DynamicResource Accent}" />
                                  <TextBlock Text="{Binding Hint}" Classes="small" TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Options}"
                                              HorizontalAlignment="Stretch">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Button Classes="versionrow" Classes.selected="{Binding IsSelected}"
                                              HorizontalAlignment="Stretch" Click="VersionOption_Click">
                                        <Grid ColumnDefinitions="4,18,*,Auto" VerticalAlignment="Center">
                                          <Border Grid.Column="0" Width="3" Height="26" CornerRadius="2"
                                                  Background="{DynamicResource Accent}" IsVisible="{Binding IsSelected}"
                                                  VerticalAlignment="Center" />
                                          <Path Grid.Column="1" Data="M 1,5 L 4,8 L 9,1" Width="10" Height="10"
                                                Stretch="None" Stroke="{DynamicResource Green}" StrokeThickness="1.6"
                                                IsVisible="{Binding IsInstalled}" VerticalAlignment="Center"
                                                ToolTip.Tip="{loc:Tr Key=installed}" />
                                          <StackPanel Grid.Column="2" Spacing="1" Margin="2,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <TextBlock Text="{Binding DisplayLabel}" FontSize="12" FontWeight="SemiBold" />
                                              <Border Classes="accent-pill" IsVisible="{Binding IsSelected}" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Tr Key=selected}" Classes="pill-text" />
                                              </Border>
                                              <Border Classes="status-pill" IsVisible="{Binding IsUpToDate}" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Tr Key=upToDateShort}" Classes="status-pill-text" />
                                              </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding VersionText}" Classes="small" />
                                            <TextBlock Text="{Binding Description}" Classes="small" TextWrapping="Wrap" />
                                          </StackPanel>
                                          <Border Grid.Column="3" Classes="kind-pill" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindLabel}" Classes="kind-pill-text" />
                                          </Border>
                                        </Grid>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                  </LayoutTransformControl>
                </Popup>

                <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                  <Button Name="PrimaryActionButton" Classes="primary" Padding="18,8"
                          Click="Install_Click" IsEnabled="False" />
                  <local:HelpTip Grid.Column="1" Name="ProtonRebuildHelp" Margin="8,0,0,0"
                                 Title="{loc:Tr Key=helpProtonRebuildTitle}"
                                 Body="{loc:Tr Key=helpProtonRebuildBody}" />
                  <TextBlock Grid.Column="2" Name="PrimaryActionHint" Classes="small" Margin="10,0,0,0"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Name="Progress" IsIndeterminate="True" IsVisible="False" Height="4" />
                <TextBlock Name="StageText" Classes="small" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Tr Key=releasesFromCatalogue}" Classes="small" />
              </StackPanel>
            </Border>

            <!-- backend and install history -->
            <Border Name="BackendSection" Classes="card">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{loc:Tr Key=linuxBackend}" Classes="h2" />
                      <local:HelpTip Name="ProtonHelp"
                                     Title="{loc:Tr Key=helpProtonTitle}"
                                     Body="{loc:Tr Key=helpProtonBody}" />
                    </StackPanel>
                    <TextBlock Name="BackendText" Classes="small" TextWrapping="Wrap" />
                    <TextBlock Name="BackendDetailText" Classes="small" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Button Name="UpdateBackendButton" Content="{loc:Tr Key=updateHelper}" Classes="ghost" FontSize="11" Padding="7,4" Click="UpdateBackend_Click" />
                    <Button Name="RefreshLocalStateButton" Content="{loc:Tr Key=refresh}" Classes="ghost" FontSize="11" Padding="7,4" Click="Refresh_Click" />
                  </StackPanel>
                </Grid>
                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerInner}" Padding="10,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{loc:Tr Key=installationHistory}" Classes="h2" />
                      <TextBlock Name="InstallationHistoryText" FontSize="11.5" TextWrapping="Wrap" />
                      <TextBlock Name="LastOperationDetailText" Classes="small" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Name="OpenHistoryButton" Content="{loc:Tr Key=viewFullHistory}"
                            Classes="ghost" FontSize="11.5" Padding="8,4" VerticalAlignment="Center"
                            Click="OpenHistory_Click" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- changelog preview -->
            <Border Name="ReleaseNotesSection" Classes="card">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Key=releaseNotes}" Classes="h2" />
                    <Border Classes="accent-pill" VerticalAlignment="Center">
                      <TextBlock Name="ChangelogChannelText" Classes="pill-text" />
                    </Border>
                    <TextBlock Name="ChangelogSourceText" Classes="small" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Grid.Column="1" Name="OpenChangelogButton" Classes="changelog" Click="Changelog_Click" />
                </Grid>
                <TextBlock Name="ChangelogUpdatedText" Classes="small" />
                <TextBlock Name="ChangelogPreview" FontSize="11.5" TextWrapping="Wrap" MaxHeight="82"
                           LineHeight="18" Foreground="{DynamicResource TextDim}" />
                <Button Name="ChangelogExpandButton" Classes="ghost" FontSize="11" Padding="8,4"
                        HorizontalAlignment="Left" IsVisible="False" Click="ChangelogExpand_Click" />
              </StackPanel>
            </Border>

            <!-- concise technical summary; full output lives in Diagnostics -->
            <Border Name="OverviewDiagnosticsSection" Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{loc:Tr Key=diagnostics}" Classes="h2" />
                    <TextBlock Text="{loc:Tr Key=overviewDiagnosticsSummary}" Classes="small" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Name="OpenDiagnosticsButton"
                          Content="{loc:Tr Key=openDiagnostics}" Classes="ghost"
                          FontSize="11.5" Padding="8,4" VerticalAlignment="Center"
                          Click="OpenDiagnostics_Click" />
                </Grid>
                <WrapPanel>
                  <TextBlock Name="GameDetectedStatus" Classes="small" Margin="0,0,14,0" />
                  <TextBlock Name="BackendVerifiedStatus" Classes="small" Margin="0,0,14,0" />
                  <TextBlock Name="OpenXrDetectedStatus" Classes="small" Margin="0,0,14,0" />
                  <TextBlock Name="DesktopInstalledStatus" Classes="small" Margin="0,0,14,0" />
                  <TextBlock Name="SteamShortcutStatusCompact" Classes="small" />
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Text="{loc:Tr Key=overviewDiagnosticsHint}" Classes="small"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Name="UninstallButton" Content="{loc:Tr Key=uninstall}"
                          Classes="danger" FontSize="11" Padding="8,4"
                          Click="Uninstall_Click" IsEnabled="False" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

          <!-- dedicated destinations; each keeps its own scroll and state -->
          <local:ReleaseExplorerView Name="ReleaseExplorerPanel" IsVisible="False" />
          <local:HistoryView Name="HistoryPanel" IsVisible="False" />
          <local:DiagnosticsView Name="DiagnosticsPanel" IsVisible="False" />
          </Grid>
        </Grid>
      </Grid>

      <!-- pinned attribution, present only on the game-selection screen -->
      <StackPanel Name="GameFooter" Grid.Row="1" HorizontalAlignment="Center" Spacing="5" Margin="0,8,0,14">
        <TextBlock Text="{loc:Tr Key=footerNote}" Classes="footer-note" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Tr Key=footerUnofficial}" Classes="footer-note" FontSize="10"
                   HorizontalAlignment="Center" />
        <Button Classes="support" HorizontalAlignment="Center" Click="OpenSupport_Click"
                ToolTip.Tip="{loc:Tr Key=supportTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="♥" FontSize="12" Foreground="{Binding $parent[Button].Foreground}" />
            <TextBlock Text="{loc:Tr Key=supportCircuitLord}" Foreground="{Binding $parent[Button].Foreground}" />
          </StackPanel>
        </Button>
        <TextBlock Text="{loc:Tr Key=supportNote}" FontSize="10.5"
                   Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- The temporary shared artwork sits above the page content and below
           dialogs, and is never hit-testable. -->
      <Canvas Name="GameTransitionLayer" Grid.Row="0" Grid.RowSpan="2" IsVisible="False"
              IsHitTestVisible="False" ClipToBounds="True">
        <Border Name="GameTransitionArtworkClip" ClipToBounds="True"
                CornerRadius="{DynamicResource CornerCardLeft}">
          <Image Name="GameTransitionArtwork"
                 Source="avares://CircuitLordVRModInstaller/Assets/titanfall-2.jpg"
                 Stretch="UniformToFill" />
        </Border>
      </Canvas>
    </Grid>

    <!-- resize grips: the window is undecorated, so these keep edge/corner resizing working -->
    <Grid Name="ResizeGrips" Grid.Row="0" Grid.RowSpan="2">
      <Border Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth"
              PointerPressed="ResizeNorth_Click" />
      <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth"
              PointerPressed="ResizeSouth_Click" />
      <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast"
              PointerPressed="ResizeWest_Click" />
      <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast"
              PointerPressed="ResizeEast_Click" />
      <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeNorthWest_Click" />
      <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeNorthEast_Click" />
      <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeSouthWest_Click" />
      <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeSouthEast_Click" />
    </Grid>

    <!-- changelog overlay -->
    <Border Name="ChangelogOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource Overlay}" IsVisible="False">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
              CornerRadius="{DynamicResource CornerCard}" Padding="22,18" MaxWidth="560" MaxHeight="680" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr Key=changelogTitle}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Name="ChangelogOverlayMeta" Classes="small" />
            </StackPanel>
            <Border Grid.Column="1" Classes="accent-pill" VerticalAlignment="Center">
              <TextBlock Name="ChangelogOverlayChannel" Classes="pill-text" />
            </Border>
          </Grid>
          <ScrollViewer Name="ChangelogScroll" MaxHeight="410" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.IsScrollChainingEnabled="False">
            <TextBlock Name="ChangelogBody" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
          </ScrollViewer>
          <Button Content="{loc:Tr Key=close}" Classes="ghost" HorizontalAlignment="Right" Click="CloseChangelog_Click" />
        </StackPanel>
      </Border>
    </Border>

    <!-- confirmation overlay -->
    <Border Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource Overlay}" IsVisible="False">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
              CornerRadius="{DynamicResource CornerCard}" Padding="22,18" MaxWidth="440" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Name="ConfirmTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ScrollViewer Name="ConfirmScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.IsScrollChainingEnabled="False">
            <TextBlock Name="ConfirmText" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Name="ConfirmCancelButton" Content="{loc:Tr Key=cancel}" Classes="ghost" Click="ConfirmCancel_Click" />
            <Button Name="ConfirmOkButton" Content="{loc:Tr Key=restartSteamAdd}" Classes="primary" Click="ConfirmOk_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- expanded settings, self-contained so the installer screen stays untouched -->
    <local:SettingsView Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" />

    <!-- startup attribution notice; dismissal is handled once by the window -->
    <Border Name="AttributionOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayStrong}" IsVisible="False">
      <Border MaxWidth="540" MaxHeight="680" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
              CornerRadius="{DynamicResource CornerCard}" Padding="22,18" Margin="12"
              HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      ScrollViewer.IsScrollChainingEnabled="False">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Image Source="avares://CircuitLordVRModInstaller/Assets/app-256.png" Width="36" Height="36"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Key=unofficialPort}" FontSize="19"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>

          <Border Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                  CornerRadius="{DynamicResource CornerInner}" Padding="12,10">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key=attributionIntro}" FontSize="12.5" TextWrapping="Wrap" />
              <TextBlock Text="{loc:Tr Key=attributionIndependent}" Classes="small" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="3">
            <TextBlock Text="{loc:Tr Key=attributionOriginalCreator}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Key=attributionBackend}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource Stroke}" />

          <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto" RowSpacing="5">
            <TextBlock Text="{loc:Tr Key=attributionOriginalApplication}" Classes="small" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" FontSize="10.5"
                    Content="https://github.com/CircuitLord/CircuitLordVRModInstaller"
                    Tag="https://github.com/CircuitLord/CircuitLordVRModInstaller"
                    Click="OpenAttributionLink_Click" />
            <TextBlock Grid.Row="1" Text="{loc:Tr Key=attributionLinuxBackend}" Classes="small" VerticalAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="1" Classes="link" FontSize="10.5"
                    Content="https://github.com/Monkellie/tf2vr-linux"
                    Tag="https://github.com/Monkellie/tf2vr-linux"
                    Click="OpenAttributionLink_Click" />
          </Grid>

          <Button Name="AttributionContinueButton" Content="{loc:Tr Key=continueLabel}" Classes="primary"
                  HorizontalAlignment="Right" MinWidth="104" Click="ContinueAttribution_Click" />
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- first-run setup wizard; shown after the attribution notice is dismissed -->
    <local:SetupWizardView Name="SetupWizardPanel" Grid.Row="0" Grid.RowSpan="2" />

  </Grid>
</LayoutTransformControl>
  </Border>
</Window>