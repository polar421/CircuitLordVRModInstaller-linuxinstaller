<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CircuitLord.VRModInstaller.Localization"
             xmlns:local="using:CircuitLord.VRModInstaller"
             x:Class="CircuitLord.VRModInstaller.ReleaseExplorerView"
             Focusable="True"
             KeyDown="Explorer_KeyDown">

  <Border Background="{DynamicResource Bg}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="18,8,18,16">

      <Grid Grid.Row="0">
        <Grid Name="ReleaseListHeader" ColumnDefinitions="Auto,*">
          <Button Name="ReleaseBackButton" Classes="ghost" Padding="10,6" VerticalAlignment="Center"
                  Click="CloseExplorer_Click" ToolTip.Tip="{loc:Tr Key=historyBackToInstaller}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M 6,0 L 0,6 L 6,12" Width="7" Height="12" Stretch="None"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                    VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr Key=historyBackToInstaller}" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr Key=releaseExplorer}" Classes="h1" />
            <TextBlock Text="{loc:Tr Key=releaseExplorerSubtitle}" Classes="small" />
          </StackPanel>
        </Grid>

        <Grid Name="ReleaseCompareHeader" IsVisible="False" ColumnDefinitions="Auto,*">
          <Button Name="CompareBackButton" Classes="ghost" Padding="10,6" VerticalAlignment="Center"
                  Click="BackToReleases_Click" ToolTip.Tip="{loc:Tr Key=backToReleases}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M 6,0 L 0,6 L 6,12" Width="7" Height="12" Stretch="None"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                    VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr Key=backToReleases}" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr Key=compareReleases}" Classes="h1" />
            <TextBlock Text="{loc:Tr Key=compareSubtitle}" Classes="small" />
          </StackPanel>
        </Grid>
      </Grid>

      <StackPanel Name="ReleaseToolbar" Grid.Row="1" Spacing="8" Margin="0,14,0,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Name="ReleaseSearchBox" PlaceholderText="{loc:Tr Key=searchVersion}" TextChanged="Search_Changed"
                   FontSize="12" Padding="10,6" />
          <ComboBox Grid.Column="1" Name="ReleaseSortCombo" MinWidth="180" SelectedIndex="0"
                    VerticalAlignment="Center" SelectionChanged="Sort_Changed"
                    ToolTip.Tip="{loc:Tr Key=sortBy}">
            <ComboBoxItem Content="{loc:Tr Key=releaseOrder}" Tag="order" />
            <ComboBoxItem Content="{loc:Tr Key=sortByVersion}" Tag="version" />
          </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <WrapPanel Name="ReleaseFilters" Orientation="Horizontal">
            <Button Content="{loc:Tr Key=historyAll}" Tag="all" Classes="filter" Margin="0,0,6,0" Click="Filter_Click" />
            <Button Content="{loc:Tr Key=stableReleases}" Tag="stable" Classes="filter" Margin="0,0,6,0" Click="Filter_Click" />
            <Button Content="{loc:Tr Key=betaReleases}" Tag="beta" Classes="filter" Margin="0,0,6,0" Click="Filter_Click" />
            <Button Content="{loc:Tr Key=pinnedFilter}" Tag="pinned" Classes="filter" Margin="0,0,6,0" Click="Filter_Click" />
            <local:HelpTip Name="PinnedReleaseHelp" VerticalAlignment="Center"
                           Title="{loc:Tr Key=helpPinnedTitle}"
                           Body="{loc:Tr Key=helpPinnedBody}" />
          </WrapPanel>
          <Button Grid.Column="1" Name="OpenCompareButton" Content="{loc:Tr Key=compareReleases}"
                  Classes="ghost" FontSize="11.5" Padding="8,4" Click="OpenCompare_Click" />
        </Grid>
      </StackPanel>

      <Grid Grid.Row="2">
        <ScrollViewer Name="ReleaseListScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.IsScrollChainingEnabled="False">
          <StackPanel Spacing="8">
            <StackPanel Name="ReleaseListPanel" Spacing="8" />
            <Border Name="ReleaseEmptyState" Classes="card" IsVisible="False" Padding="18,22" Margin="0">
              <TextBlock Name="ReleaseEmptyText" Classes="small" TextAlignment="Center"
                         HorizontalAlignment="Center" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="ReleaseCompareScroll" IsVisible="False" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.IsScrollChainingEnabled="False">
          <StackPanel Spacing="10">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="{loc:Tr Key=releaseA}" Classes="small" />
                <ComboBox Name="CompareLeftCombo" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{loc:Tr Key=releaseA}"
                          SelectionChanged="CompareSelection_Changed" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{loc:Tr Key=releaseB}" Classes="small" />
                <ComboBox Name="CompareRightCombo" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{loc:Tr Key=releaseB}"
                          SelectionChanged="CompareSelection_Changed" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Classes="card compare-card" Margin="0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Name="CompareVersionA" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Name="CompareChannelA" Classes="small" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center">
                      <Border Name="CompareInstalledBadgeA" Classes="status-pill" IsVisible="False">
                        <TextBlock Text="{loc:Tr Key=installed}" Classes="status-pill-text" />
                      </Border>
                      <Border Name="CompareSelectedBadgeA" Classes="accent-pill" IsVisible="False">
                        <TextBlock Text="{loc:Tr Key=selected}" Classes="pill-text" />
                      </Border>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Stroke}" />
                  <TextBlock Text="{loc:Tr Key=releaseDescription}" Classes="small" FontWeight="SemiBold" />
                  <TextBlock Name="CompareDescriptionA" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{loc:Tr Key=releaseNotes}" Classes="small" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Name="CompareChangelogA" FontSize="11" Foreground="{DynamicResource TextDim}"
                             TextWrapping="Wrap" />
                  <Button Name="CompareSelectA" Classes="ghost" FontSize="11.5" Padding="8,4"
                          HorizontalAlignment="Left" Click="SelectCompareA_Click" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card compare-card" Margin="0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Name="CompareVersionB" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Name="CompareChannelB" Classes="small" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center">
                      <Border Name="CompareInstalledBadgeB" Classes="status-pill" IsVisible="False">
                        <TextBlock Text="{loc:Tr Key=installed}" Classes="status-pill-text" />
                      </Border>
                      <Border Name="CompareSelectedBadgeB" Classes="accent-pill" IsVisible="False">
                        <TextBlock Text="{loc:Tr Key=selected}" Classes="pill-text" />
                      </Border>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Stroke}" />
                  <TextBlock Text="{loc:Tr Key=releaseDescription}" Classes="small" FontWeight="SemiBold" />
                  <TextBlock Name="CompareDescriptionB" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{loc:Tr Key=releaseNotes}" Classes="small" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Name="CompareChangelogB" FontSize="11" Foreground="{DynamicResource TextDim}"
                             TextWrapping="Wrap" />
                  <Button Name="CompareSelectB" Classes="ghost" FontSize="11.5" Padding="8,4"
                          HorizontalAlignment="Left" Click="SelectCompareB_Click" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Name="CompareDiffCard" Classes="card compare-card" Margin="0">
              <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr Key=compareDifferences}" Classes="h2" />
                <TextBlock Text="{loc:Tr Key=compareDifferencesHint}" Classes="small" />
                <TextBlock Name="CompareDiffText" FontSize="11" LineHeight="17"
                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>

    </Grid>
  </Border>
</UserControl>
