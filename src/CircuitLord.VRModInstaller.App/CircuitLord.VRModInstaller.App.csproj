<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>CircuitLordVRModInstaller</AssemblyName>
    <RootNamespace>CircuitLord.VRModInstaller</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Product>CircuitLord's VR Mod Installer (Linux)</Product>
    <Version>1.0.9-beta.4</Version>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- Native Wayland is opt-in in Avalonia; UseWaylandWithFallback keeps X11 working. -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CircuitLord.VRModInstaller.Core/CircuitLord.VRModInstaller.Core.csproj" />
  </ItemGroup>

</Project>
